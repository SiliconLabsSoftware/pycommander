[run]
source =
  packages/pycommander-core
  packages/pycommander-cli
  packages/pycommander-gui
  packages/pycommander

omit = 
  */__init__.py
  */__main__.py
  */tests/*
  */mock_*.py
  */build_hook.py

[paths]
source =
  packages
  *\packages
  */packages

[report]
sort = Cover
show_missing = true
skip_covered = true
